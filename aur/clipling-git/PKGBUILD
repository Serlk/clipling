# Maintainer: Serlk <22211586+Serlk at users dot noreply dot github dot com>

pkgname=clipling-git
_pkgname=clipling
pkgver=0.1.0.r0.gf029143
pkgrel=1
pkgdesc='Popup clipboard picker for clipvault history: opens at the cursor, text and image previews (GTK4, layer-shell) (git version)'
arch=('x86_64' 'aarch64')
url='https://github.com/Serlk/clipling'
license=('AGPL-3.0-only')
depends=(
  'clipvault'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'glibmm-2.68'
  'gtk4'
  'gtk4-layer-shell'
  'gtkmm-4.0'
  'libgcc'
  'libsigc++-3.0'
  'libstdc++'
  'sqlite'
  'wl-clipboard'
)
makedepends=('git' 'meson')
optdepends=('hyprland: open the popup at the mouse cursor (via hyprctl)')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  arch-meson "$_pkgname" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "$_pkgname/README.md" "$pkgdir/usr/share/doc/$_pkgname/README.md"
}
